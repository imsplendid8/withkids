# docker compose가 읽는 설정. 이 파일을 .env로 복사해서 값을 채운다.
#
#   cp .env.example .env
#
# .env는 gitignore되어 있다. 비밀번호를 여기(.env.example)에 적지 말 것.

# ── 필수 ────────────────────────────────────────────────────
# 아무 값이나 길게. 셋 다 비워두면 docker compose가 실행을 거부한다.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 로그인 토큰 서명 키. 반드시 추측 불가능한 값으로.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=7d

# ── Cloudflare Tunnel (외부 접속용) ─────────────────────────
# Cloudflare Zero Trust > Networks > Tunnels 에서 터널을 만들면 주는 토큰.
# 설정하지 않으면 로컬(http://localhost:3000)에서만 쓴다.
CLOUDFLARE_TUNNEL_TOKEN=

# ── 크롤러 (선택) ───────────────────────────────────────────
# 서울 열린데이터광장 인증키. https://data.seoul.go.kr > 인증키 신청 (무료)
# 비어 있으면 서울 어댑터는 경고만 남기고 건너뛴다.
SEOUL_OPENAPI_KEY=

# ── 예약 알림 메일 (선택) ───────────────────────────────────
# Gmail은 2단계 인증 후 "앱 비밀번호"(16자리)를 SMTP_PASSWORD에 넣는다.
# 비어 있으면 메일 전송만 실패하고 앱은 정상 동작한다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
