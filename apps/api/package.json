{
  "name": "@withdkis/api",
  "version": "0.1.0",
  "description": "WithDKIS API Server",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "type-check": "tsc --noEmit -p tsconfig.spec.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "db:migrate": "typeorm migration:run -d src/database/data-source.ts",
    "db:migrate:create": "typeorm migration:create",
    "db:seed": "node dist/database/seed.js",
    "crawler:verify": "ts-node --project tsconfig.json scripts/verify-seoul-api.ts",
    "export:programs": "ts-node --project tsconfig.json scripts/export-programs.ts",
    "export:festivals": "ts-node --project tsconfig.json scripts/export-festivals.ts",
    "export:notices": "ts-node --project tsconfig.json scripts/export-notices.ts",
    "export:paid": "ts-node --project tsconfig.json scripts/export-paid.ts"
  },
  "dependencies": {
    "@bull-board/express": "^9.10.0",
    "@bull-board/ui": "^9.10.0",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/common": "^10.2.8",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.2.8",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^7.1.8",
    "@nestjs/typeorm": "^9.0.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "postgres": "^3.3.5",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.2",
    "@nestjs/testing": "^10.2.8",
    "@types/bull": "^3.15.9",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^3.0.9",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
