rules_version = '2';

// WITHKIDS: 로그인한 사람은 자기 문서(users/{자기 uid})만 읽고 쓰고 지울 수 있다.
// 문서 모양도 검사한다: store(브라우저 데이터 묶음)와 updatedAt(서버 시각) 두 칸만,
// store는 키 60개 이하. 문서 한 개 최대 1MB는 Firestore가 막는다.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 [게시]를 누른다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['store', 'updatedAt'])
        && request.resource.data.store is map
        && request.resource.data.store.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }
  }
}
