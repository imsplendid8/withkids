rules_version = '2';

// WITHKIDS: 로그인한 사람은 자기 문서(users/{자기 uid})만 읽고 쓸 수 있다.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 [게시]를 누른다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
